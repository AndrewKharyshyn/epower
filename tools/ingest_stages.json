    "tools/ingest_core.py"
   ],
   "verified": true,
   "implemented": true,
   "outputs": [
    "drive_master.csv",
    "raw_manifest.json",
    "summary_config.json",
    "summary_arrays.json"
   ]
  },
  {
   "id": "post_steps",
