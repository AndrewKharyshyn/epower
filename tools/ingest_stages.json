    "bash",
    "apply_m284_post.sh"
   ],
   "verified": true,
   "outputs": [
    "summary_arrays.json",
    "summary_config.json"
   ]
  },
  {
   "id": "cohort_arrays",
   "title": "Per-cohort arrays regenerate",
   "cmd": [
