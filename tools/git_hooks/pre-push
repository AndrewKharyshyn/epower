#!/bin/sh
# M777: pre-push guard. CI fails when Python source opens a file without an explicit encoding (the Windows default is cp1251).
# Runs in seconds; install with: python tools/install_git_hooks.py
PY=python; command -v python >/dev/null 2>&1 || PY=python3
"$PY" tests/synthetic/test_encoding_guard.py || {
  echo "pre-push: encoding guard failed. Pass encoding=\"utf-8\" to every open() / read_text / write_text, then push again." >&2
  exit 1
}
